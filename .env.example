# Copie para .env (cp .env.example .env). Os valores abaixo já funcionam com o docker-compose.

# ----- Collector Python -----
# Cidade monitorada (padrão: São João del-Rei - MG)
CITY_LATITUDE=-21.1356
CITY_LONGITUDE=-44.2614

API_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

HOST_RABBITMQ=rabbitmq
PORT_RABBITMQ=5672
USER_RABBITMQ=guest
PASSWORD_RABBITMQ=guest

# Compartilhados entre Python e Go
EXCHANGE_NAME=weather_exchange
QUEUE_NAME=weather_data_queue

# ----- Worker Go -----
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ----- Banco (Worker Go + Nest API) -----
# Mongo local do compose (replica set de 1 nó, exigido pelo Prisma).
# Deve terminar em /climate_dashboard. Para usar Atlas, troque por sua connection string.
DATABASE_URL=mongodb://mongo:27017/climate_dashboard?replicaSet=rs0&directConnection=true

# ----- Nest API -----
SERVER_PORT=3000
# Troque por um segredo longo e aleatório
JWT_SECRET=change-me-to-a-long-random-secret

# Usuário de demonstração (visitante@gmail.com) criado na subida da API
SEED_GUEST_USER=true
GUEST_PASSWORD=12345678

# LLM (Groq por padrão, API compatível com OpenAI). Sem chave, a API usa uma regra local.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ----- Frontend (build) -----
# URL da API acessível pelo navegador
VITE_API_URL=http://localhost:3000
