generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Users {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String @unique
  password String
}

model weather {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  localization String
  temp           Float
  humidity       Int
  windSpeed      Float   @map("wind_speed")
  conditionSky   String  @map("condition_sky")
  probabilityRain Int    @map("probability_rain")
  insightsAI     String? @map("insights_ai")
  measuredAt     DateTime @map("measured_at")
  createdAt      DateTime @default(now()) @map("created_at")
}
